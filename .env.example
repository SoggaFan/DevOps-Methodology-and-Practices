# Local development only. Use unique, private passwords outside this example.
POSTGRES_DB=fishing
POSTGRES_USER=fishing_admin
POSTGRES_PASSWORD=replace_with_a_long_admin_password
POSTGRES_APP_PASSWORD=replace_with_a_different_app_password
APP_PORT=8000

# Used by `make run` outside Docker. The local host port is published only on 127.0.0.1.
DATABASE_URL=postgresql+psycopg://fishing_app:replace_with_a_different_app_password@127.0.0.1:5432/fishing
