# Copy to /opt/fishing-firm-preprod/.env on the Linux target host.
# Use unique strong passwords. This file must remain outside Git.
POSTGRES_DB=fishing_preprod
POSTGRES_USER=fishing_admin
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Docker Hub repository that the CI publish job writes to.
IMAGE_REPOSITORY=docker.io/DOCKERHUB_USERNAME/fishing-firm
# Initial placeholder. The release script replaces these on first deployment.
IMAGE_TAG=UNDEPLOYED
APP_VERSION=UNDEPLOYED
APP_COMMIT=unknown
APP_PORT=18000
