[Unit]
Description=Fishing Firm FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fishing
Group=fishing
WorkingDirectory=/opt/fishing-firm
EnvironmentFile=/etc/fishing-firm/fishing-firm.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/fishing-firm/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=027

[Install]
WantedBy=multi-user.target
